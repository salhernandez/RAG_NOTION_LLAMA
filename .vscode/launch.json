{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Debug load_docs_file_to_index",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/marqo/code_samples/load_docs_file_to_index.py",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Python: Debug getDataFromPage.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/notion/getDataFromPage.py",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Python: Flask",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "args": [
              "run",
              "--debug",
              "-h", "0.0.0.0",
              "-p", "5001"
            ],
            "cwd": "${workspaceFolder}/backend", // Sets the working directory to the backend folder
            "env": {
              "FLASK_APP": "app.py" // Refers to app.py within the backend folder
            },
            "jinja": true
          }
    ]
}
